msgid "핀 수"
msgstr "Pin 数量"

msgid "최소 두 개의 태그를 선택하세요."
msgstr "请至少选择两个标签。"

msgid "태그 병합"
msgstr "合并标签"

msgid "대표 태그를 선택하세요."
msgstr "请选择一个主要标签。"

msgid "{}개 태그를 {} 태그로 병합했습니다."
msgstr "已将 {} 个标签合并到 {}。"

msgid "선택한 태그 병합"
