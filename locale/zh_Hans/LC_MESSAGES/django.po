msgid "대표 태그가 선택 범위에 없습니다."
msgstr "所选主要标签不在选择范围内。"

msgid "선택한 태그가 변경되었습니다. 다시 시도하세요."
msgstr "所选标签已变化，请重试。"

msgid "대표 태그 선택"
msgstr "选择主要标签"

msgid "선택한 태그의 핀 연결을 대표 태그 하나로 합칩니다. 나머지 태그는 삭제됩니다."
msgstr "所选标签的 Pin 关联将合并到一个主要标签，其余标签将被删除。"

msgid "병합"
msgstr "合并"

msgid "취소"
msgstr "取消"

msgid "Pin"
msgstr "Pin"

msgid "보드"
