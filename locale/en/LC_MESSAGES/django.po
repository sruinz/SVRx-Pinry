msgid "핀 수"
msgstr "Pin count"

msgid "최소 두 개의 태그를 선택하세요."
msgstr "Select at least two tags."

msgid "태그 병합"
msgstr "Merge tags"

msgid "대표 태그를 선택하세요."
msgstr "Select a primary tag."

