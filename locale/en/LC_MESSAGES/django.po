msgid "선택한 태그의 핀 연결을 대표 태그 하나로 합칩니다. 나머지 태그는 삭제됩니다."
msgstr "Merge pin links of the selected tags into one primary tag. The remaining tags are deleted."

msgid "병합"
msgstr "Merge"

msgid "취소"
msgstr "Cancel"

msgid "Pin"
msgstr "Pin"

msgid "보드"
