msgid "핀 수"
msgstr "Nombre de fiches"

msgid "최소 두 개의 태그를 선택하세요."
msgstr "Sélectionnez au moins deux tags."

msgid "태그 병합"
msgstr "Fusionner les tags"

msgid "대표 태그를 선택하세요."
msgstr "Sélectionnez un tag principal."

msgid "{}개 태그를 {} 태그로 병합했습니다."
msgstr "{} tags fusionnés dans {}."

msgid "선택한 태그 병합"
msgstr "Fusionner les tags sélectionnés"

msgid "대표 태그가 선택 범위에 없습니다."
msgstr "Le tag principal choisi est hors de la sélection."

msgid "선택한 태그가 변경되었습니다. 다시 시도하세요."
msgstr "Les tags sélectionnés ont changé. Réessayez."

msgid "대표 태그 선택"
msgstr "Sélectionner le tag principal"

msgid "선택한 태그의 핀 연결을 대표 태그 하나로 합칩니다. 나머지 태그는 삭제됩니다."
msgstr "Fusionne les associations de fiches des tags sélectionnés en un seul tag principal. Les autres tags sont supprimés."

msgid "병합"
msgstr "Fusionner"

msgid "취소"
msgstr "Annuler"

msgid "Pin"
msgstr "Fiche"

msgid "보드"
msgstr "Tableau"

msgid "이미지"
msgstr "Image"

msgid "썸네일"
msgstr "Miniature"

msgid "코어"
msgstr "Noyau"
