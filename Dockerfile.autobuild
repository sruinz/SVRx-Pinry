# -----------------------------------------------------------------------------
# docker-pinry
#
# Builds a basic docker image that can run Pinry and serve
# all of it's assets, there are more optimal ways to do this but this is the
# most friendly and has everything contained in a single instance.
#
# Authors: Isaac Bythewood, Jason Kaltsikis
# Updated: May 2nd, 2020
# Require: Docker (http://www.docker.io/)
# -----------------------------------------------------------------------------

# Build static pnpm file
FROM node:24.21.0-bookworm as pnpm-build

WORKDIR pinry-spa
COPY pinry-spa/package.json pinry-spa/pnpm-lock.yaml ./
RUN npm install -g pnpm@9.15.9
RUN pnpm install --frozen-lockfile
COPY pinry-spa .
RUN pnpm build


# Required for other database options
FROM python:3.14-slim-bookworm as base
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && if [ $(dpkg --print-architecture) = "arm64" -o $(dpkg --print-architecture) = "armhf" ]; then apt-get -y install apt-utils; fi \
    && apt-get -y install pkg-config gcc default-libmysqlclient-dev
RUN python -m pip install --no-cache-dir --prefix=/install \
    mysqlclient==2.2.8 oracledb==4.0.2


# Final image
FROM python:3.14-slim-bookworm
ARG DEBIAN_FRONTEND=noninteractive
ARG PINRY_SOURCE_COMMIT=development
ENV PINRY_SOURCE_COMMIT=${PINRY_SOURCE_COMMIT}

WORKDIR pinry
RUN mkdir /data && chown -R www-data:www-data /data

RUN groupadd -g 2300 tmpgroup \
 && usermod -g tmpgroup www-data \
 && groupdel www-data \
 && groupadd -g 1000 www-data \
 && usermod -g www-data www-data \
 && usermod -u 1000 www-data \
 && groupdel tmpgroup

RUN apt-get update \
    # Install nginx
    && apt-get -y  install nginx pwgen \
    # MySQL/MariaDB 드라이버 런타임 라이브러리 설치
    && apt-get -y install libmariadb3 \
    # Install Pillow dependencies
    && apt-get -y install libopenjp2-7 libjpeg-turbo-progs libjpeg62-turbo-dev libtiff-dev libxcb1 \
    # Needed to compile psycopg2 on arm (fallback for psycopg2-binary)
    && if [ $(dpkg --print-architecture) = "arm64" -o $(dpkg --print-architecture) = "armhf" ]; then apt-get -y install apt-utils libpq-dev gcc; fi \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get autoclean

# Install Pipfile requirements
COPY requirements.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt

# Copy from previous stages
COPY --from=pnpm-build pinry-spa/dist /pinry/pinry-spa/dist
COPY --from=base /install /usr/local
RUN python -c "import os, pwd; \
    account = pwd.getpwnam('www-data'); \
    os.setgroups([]); \
    os.setgid(account.pw_gid); \
    os.setuid(account.pw_uid); \
    assert os.geteuid() == account.pw_uid != 0; \
    assert os.getegid() == account.pw_gid != 0; \
    import MySQLdb, oracledb"

COPY manage.py ./
COPY core ./core
COPY exports ./exports
COPY django_images ./django_images
COPY pinry ./pinry
COPY pinry_plugins ./pinry_plugins
COPY users ./users
COPY locale ./locale
COPY docker/scripts ./docker/scripts
COPY docker/migration ./docker/migration
COPY LICENSE.md NOTICE.md UPSTREAM.md /usr/share/licenses/svrx-pinry/

RUN chown -R root:root /pinry /usr/share/licenses/svrx-pinry \
    && find /pinry /usr/share/licenses/svrx-pinry -type d -exec chmod 0755 {} + \
    && find /pinry /usr/share/licenses/svrx-pinry -type f -exec chmod 0644 {} + \
    && chmod 0755 /pinry/docker/scripts/*.sh

# Load in all of our config files.
ADD docker/nginx/nginx.conf /etc/nginx/nginx.conf
ADD docker/nginx/sites-enabled/default /etc/nginx/sites-enabled/default
COPY docker/nginx/recovery.conf.template /pinry/docker/nginx/recovery.conf.template

# 80 is for nginx web, /data contains static files and database /start runs it.
EXPOSE 80
ENV DJANGO_SETTINGS_MODULE pinry.settings.docker
VOLUME ["/data"]
CMD    ["/pinry/docker/scripts/start.sh"]
