server {
    listen 80 default;
    server_name _;

    access_log /dev/stdout;
    error_log /dev/stderr warn;

    root /pinry/pinry-spa/dist/;

    client_max_body_size 50M;
    add_header X-Frame-Options sameorigin always;

    error_page 418 = @migration_page;
    error_page 419 = @migration_unavailable;
    error_page 420 = @migration_home;

    # 헤더 파싱은 location 선택보다 먼저 실행되므로 서버 단계에서 분기한다.
    error_page 400 = /__startup_recovery_bad_request;
    error_page 494 = /__startup_recovery_header_too_large;

    location = /__startup_recovery_bad_request {
        internal;
        default_type application/json;
        if ($request_uri ~ "^/migration/(recovery|restart)(\?|$)") {
            add_header Cache-Control "no-store" always;
            add_header X-Content-Type-Options nosniff always;
            return 400 '{"reason":"invalid_body"}';
        }
        return 400;
    }

    location = /__startup_recovery_header_too_large {
        internal;
        default_type application/json;
        if ($request_uri ~ "^/migration/(recovery|restart)(\?|$)") {
            add_header Cache-Control "no-store" always;
            add_header X-Content-Type-Options nosniff always;
            return 400 '{"reason":"invalid_headers"}';
        }
        # 제어 외 요청은 기존 큰 헤더 전용 HTML 400 응답을 유지한다.
        return 494;
    }

    location @migration_home {
        absolute_redirect off;
        add_header Cache-Control "no-store" always;
        return 302 /;
    }

    location @migration_page {
        root /pinry/docker;
        charset utf-8;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Content-Security-Policy "frame-ancestors 'self'" always;
        add_header Cache-Control "no-store" always;
        add_header Allow "GET, HEAD" always;
        try_files /migration/index.html =503;
    }

    location @migration_unavailable {
        add_header Cache-Control "no-store" always;
        add_header Retry-After "5" always;
        return 503;
    }

    location = /migration {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        if (!-f /run/svrx-pinry/maintenance) { return 420; }
        add_header Cache-Control "no-store" always;
        add_header Allow "GET, HEAD" always;
        return 308 /migration/;
    }

    location = /migration/ {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        if (!-f /run/svrx-pinry/maintenance) { return 420; }
        add_header Cache-Control "no-store" always;
        add_header Allow "GET, HEAD" always;
        return 418;
    }

    location = /migration/index.html {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        if (!-f /run/svrx-pinry/maintenance) { return 420; }
        add_header Cache-Control "no-store" always;
        add_header Allow "GET, HEAD" always;
        return 418;
    }

    location @recovery_unavailable {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        return 503 '{"reason":"unavailable"}';
    }

    location @recovery_body_too_large {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        return 413 '{"reason":"invalid_body"}';
    }

    location @recovery_rate_limit {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        return 429 '{"reason":"rate_limited"}';
    }

    location = /migration/recovery {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        if ($request_method != GET) { return 405 '{"reason":"method_not_allowed"}'; }
        if (!-f /run/svrx-pinry/maintenance) { return 409 '{"reason":"unavailable"}'; }
        if ($http_transfer_encoding != "") { return 400 '{"reason":"invalid_body"}'; }
        if ($http_content_length !~ "^(0)?$") { return 400 '{"reason":"invalid_body"}'; }
        limit_req zone=startup_recovery burst=4;
        limit_req_status 429;
        error_page 413 = @recovery_body_too_large;
        error_page 429 = @recovery_rate_limit;
        error_page 502 504 = @recovery_unavailable;
        # 상류 정책의 429와 Retry-After를 그대로 전달한다.
        proxy_intercept_errors off;
        proxy_hide_header Cache-Control;
        proxy_hide_header X-Content-Type-Options;
        proxy_set_header Host $http_host;
        proxy_connect_timeout 1s;
        proxy_read_timeout 1s;
        proxy_send_timeout 1s;
        proxy_pass http://unix:/run/svrx-pinry/startup-recovery.sock;
    }

    location = /migration/restart {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        if ($request_method != POST) { return 405 '{"reason":"method_not_allowed"}'; }
        if (!-f /run/svrx-pinry/maintenance) { return 409 '{"reason":"unavailable"}'; }
        if ($http_transfer_encoding != "") { return 400 '{"reason":"invalid_body"}'; }
        if ($http_content_length !~ "^(0)?$") { return 400 '{"reason":"invalid_body"}'; }
        limit_req zone=startup_recovery burst=4;
        limit_req_status 429;
        error_page 413 = @recovery_body_too_large;
        error_page 429 = @recovery_rate_limit;
        error_page 502 504 = @recovery_unavailable;
        proxy_intercept_errors off;
        proxy_hide_header Cache-Control;
        proxy_hide_header X-Content-Type-Options;
        proxy_set_header Host $http_host;
        proxy_connect_timeout 1s;
        proxy_read_timeout 1s;
        proxy_send_timeout 1s;
        proxy_pass http://unix:/run/svrx-pinry/startup-recovery.sock;
    }

    location = /migration-status.json {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        alias /run/svrx-pinry/migration-status.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header Allow "GET, HEAD" always;
    }

    location ^~ /migration/ {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        alias /pinry/docker/migration/;
        charset utf-8;
        charset_types text/css application/javascript;
        add_header Cache-Control "no-store" always;
        add_header Allow "GET, HEAD" always;
    }

    location = /healthz {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        add_header Allow "GET, HEAD" always;
        return 200 "ok\n";
    }

    location = /readyz {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        if (-f /run/svrx-pinry/maintenance) { return 419; }
        add_header Cache-Control "no-store" always;
        add_header Allow "GET, HEAD" always;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://127.0.0.1:8000/api/v2/version/;
    }

    location = /service-worker.js {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        add_header Service-Worker-Allowed / always;
        add_header X-Content-Type-Options nosniff always;
        add_header Allow "GET, HEAD" always;
        try_files /service-worker.js =404;
    }

    location /static {
        if (-f /run/svrx-pinry/maintenance) { return 419; }
        alias /data/static;
        expires max;
        access_log off;
    }

    location /media {
        if (-f /run/svrx-pinry/maintenance) { return 419; }
        alias /data/static/media;
        expires max;
        access_log off;
    }

    location ^~ /__protected_exports/ {
        internal;
        alias /data/exports/ready/;
        disable_symlinks on;
        default_type application/zip;
    }

    location = /api/v2/pins/batch/ {
        if (-f /run/svrx-pinry/maintenance) { return 419; }
        client_max_body_size 1m;
        proxy_read_timeout 65s;
        proxy_send_timeout 65s;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://127.0.0.1:8000;
        break;
    }

    location /api {
        if (-f /run/svrx-pinry/maintenance) { return 419; }
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://127.0.0.1:8000;
        break;
    }

    location /admin {
        if (-f /run/svrx-pinry/maintenance) { return 419; }
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://127.0.0.1:8000;
        break;
    }

    location / {
        set $svrx_maintenance_gate "";
        if (-f /run/svrx-pinry/maintenance) {
            set $svrx_maintenance_gate "read";
        }
        if ($request_method !~ ^(GET|HEAD)$) {
            set $svrx_maintenance_gate "$svrx_maintenance_gate-write";
        }
        if ($svrx_maintenance_gate = "read-write") { return 419; }
        if ($svrx_maintenance_gate = "read") { return 418; }
        try_files $uri $uri/ /index.html;
        access_log off;
    }
}
